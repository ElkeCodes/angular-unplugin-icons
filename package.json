{
  "name": "angular-unplugin-icons",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build-stats": "ng build --configuration production --stats-json",
    "open-analyze-report": "esbuild-visualizer --metadata dist/angular-unplugin-icons/stats.json --filename dist/angular-unplugin-icons/bundle-report.html --open",
    "analyze": "npm run build-stats && npm run open-analyze-report",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@10.9.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-builders/custom-esbuild": "^21.0.3",
    "@angular/build": "^21.2.7",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^21.2.0",
    "@iconify/json": "^2.2.461",
    "esbuild-visualizer": "^0.7.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "unplugin-icons": "^23.0.1",
    "vitest": "^4.0.8"
  }
}
